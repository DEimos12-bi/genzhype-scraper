        "id": "1498102613639892996",
        "name": "Bishop 🏴‍☠️ 🇺🇦",
        "screenName": "TheLockheedLib",
        "profileImageUrl": "https://pbs.twimg.com/profile_images/2114384562725806081/xexLm4NO_normal.jpg",
        "verified": true
