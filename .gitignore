__pycache__/
*.pyc

# r186: the renderer unpacks the job feed into feeddir/ at run time; these are
# working files that belong on the video-feed branch, never in main (a bug kept
# committing 780 MB of downloaded clips and article images to this public repo).
feed.json
clips/
visuals/
feeddir/

# 2026-09-24: never publish a token. Posters used to save refreshed tokens in
# .social/ and their workflows commit .social - so .social/th_token.txt sat in
# this PUBLIC repo from 07-05 to 09-24. Any *token* file there is now ignored.
.social/*token*
